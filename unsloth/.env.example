# Скопировать в .env рядом с docker-compose.yml и поправить под себя,
# либо передавать переменные прямо в командной строке при up.

# Обязательно: куда на хосте складывать модели и рабочие данные
UNSLOTH_HOST_DIR=/mnt/data1/unsloth

# Вариант сборки: cu128 (RTX 4090, CUDA 12.8) | cu130 (RTX 5090, CUDA 13)
CUDA_VARIANT=cu128

# Порт Studio на хосте (внутри контейнера всегда 8000)
STUDIO_HOST_PORT=8000

# Токен Hugging Face (опционально, нужен только для gated-моделей)
HF_TOKEN=

# Пароль админа Studio при первом старте (потом меняется в настройках UI).
# Studio требует минимум 8 символов. 12345678 — слабый, держать только в частной сети.
UNSLOTH_STUDIO_PASSWORD=12345678

# Если сеть подменяет TLS-сертификаты = 1 (иначе загрузки HF падают с "CAS Client Error").
HF_HUB_DISABLE_XET=0

# --- Сервинг для агентов (ветка server-serving форка github.com/RepnikovPavel/unsloth) ---
# Тарболл пакета с фиксами; пусто = стоковый PyPI-пакет.
# ВАЖНО: для обновления пакета на уже работающем сервере пиньте КОММИТ, а не ветку
# (https://github.com/RepnikovPavel/unsloth/archive/<sha>.tar.gz) — uv кэширует
# тарболл по URL, и перевыбор той же ветки может поднять старый код. Либо
# `docker exec <container> rm /data/studio/.unsloth_package_spec` + restart.
UNSLOTH_PACKAGE_SPEC=https://github.com/RepnikovPavel/unsloth/archive/6fe3de414397c05d104ebdbd661a10c221f807e7.tar.gz
# Контекст модели (262144 = нативные 256K Qwen3.8-27B); лоадер сам закрепит обе GPU
UNSLOTH_LLAMA_CTX_SIZE=262144
# 1 слот = полный контекст на запрос; пользователи в очереди, а не делят контекст
UNSLOTH_LLAMA_N_PARALLEL=1
# Пул GPU ("0,1"); пусто = все видимые
UNSLOTH_LLAMA_GPU_IDS=
# Per-user KV-снапшоты по API-ключам; TTL 3 суток (259200 с).
# Для гибридных моделей (qwen35) дисковый своп пропускается — переключение
# обслуживает prompt cache в RAM (см. следующую переменную).
UNSLOTH_KV_SESSIONS=1
UNSLOTH_KV_SESSION_TTL_S=259200
# Лимит prompt cache llama-server, МиБ (-1 = без лимита, 0 = выкл). Дефолт
# апстрима 8192 не вмещает сессию ~200K токенов (~14-19 ГиБ) — тогда смена
# пользователя = полный re-prefill всего контекста.
UNSLOTH_LLAMA_CACHE_RAM_MIB=131072
